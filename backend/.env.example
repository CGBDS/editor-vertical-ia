# Puerto del backend
PORT=4000

# Ruta al logo de la marca de agua (PNG con transparencia) — OBLIGATORIO
WATERMARK_PATH=../assets/watermark.png

# Ruta a la tipografía Impact (requerida para subtítulos quemados) — OBLIGATORIO
FONT_PATH=../assets/fonts/impact.ttf

# Música de fondo opcional: si el prompt pide música y este archivo existe,
# se mezcla bajo el audio original al 15% de volumen
BGM_PATH=

# Trabajos FFmpeg simultáneos (videos largos consumen CPU)
MAX_CONCURRENT_JOBS=2

# Horas que se conservan subidas y resultados antes de borrarse
RETENTION_HOURS=24

# Directorios de trabajo
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# Carpeta del frontend estático que sirve el backend en el mismo origen
# (en Docker: /app/public). Si no existe, el backend expone solo la API.
FRONTEND_DIR=../frontend/out

# Whisper (opcional): comando para generar subtítulos automáticos desde el audio.
# Ej: WHISPER_CMD="whisper --model small --language es --output_format srt"
# Si está vacío, los subtítulos automáticos se omiten sin romper el pipeline.
WHISPER_CMD=

# Hook opcional para un LLM externo que refine las directivas del prompt
LLM_API_URL=
